/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/sopa Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 256.GB * task.attempt }
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
        queue = 'gpu_rtx8000_48gb'
        clusterOptions = ['--account=gpu_gordon-weeks.prj', '--gpus=1']
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName:TO_SPATIALDATA {
        cpus   = { 32                   }
        memory = { 1000.GB              }
        time   = { 30.h                 }
        queue  = 'himem'
    }
    withName:COMBINE_SEGMENTATION_CHANNELS {
        containerOptions = '--bind /well/gordon-weeks/projects/pipelines/jonasmac16-nf-sopa_feature/cellpose-combine-channels/feature_cellpose_combine_channels/assets:/opt/assets'
        cpus   = { 6     * task.attempt }
        memory = { 70.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withName:MAKE_IMAGE_PATCHES {
        cpus   = { 8     * task.attempt }
        memory = { 100.GB * task.attempt }
    }
    withName:MAKE_TRANSCRIPT_PATCHES {
        cpus   = { 8     * task.attempt }
        memory = { 100.GB * task.attempt }
    }
    withName:PATCH_SEGMENTATION_PROSEG {
        cpus   = { 8      * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 10.d   * task.attempt }
    }
    withName:PATCH_SEGMENTATION_CELLPOSE {
        containerOptions = '--bind /well/gordon-weeks/shared/models/.cellpose/models:/opt/cellpose_models'
        memory = { 100.GB * task.attempt }
    }
    withName:PATCH_SEGMENTATION_BAYSOR {
       cpus   = { 16                    }
       memory = { 700.GB * task.attempt }
       time   = { 30.h                  }
       maxRetries = { 1                 }
       queue = 'himem'
    }
    withName:AGGREGATE {
        cpus   = { 8     * task.attempt }
        memory = { 150.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName:EXPLORER_RAW {
       ext.when = false
    }
    withName:EXPLORER {
       ext.when = false
    }
}
